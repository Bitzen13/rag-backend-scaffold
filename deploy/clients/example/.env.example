# One client's secrets and per-deployment knobs. Copy to `.env` in this directory and fill in.
# Never commit the filled-in file: it is this client's credentials and nothing else's.

# --- provider keys (only the ones this client's config.yaml selects) --------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- this client's database --------------------------------------------------------------------
# Not published outside the stack, but still generate a real password: it is one `ports:` line
# away from being reachable, and a shared default would be shared across clients.
POSTGRES_USER=rag
POSTGRES_PASSWORD=
POSTGRES_DB=rag

# --- the internal admin surface ----------------------------------------------------------------
# Leave blank and /internal is not mounted at all. Set it to trigger ingestion or manage keys
# over HTTP; it must be per-client, because it is the key to this client's whole corpus.
ADMIN_API_TOKEN=

# --- where this instance listens ---------------------------------------------------------------
# One host running several clients gives each a different port behind the proxy.
API_PORT=8000

# --- process count -----------------------------------------------------------------------------
# Workers are async, so concurrency comes from the event loop rather than this number; each one
# holds its own database pool and provider clients (docker/gunicorn.conf.py).
WEB_CONCURRENCY=2

# The image to run. Pinned on purpose: `latest` means a restart can quietly change versions.
# Bump this deliberately, when you have decided to deploy a new build.
IMAGE=rag-backend:1.0.0
