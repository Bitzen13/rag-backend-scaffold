# Provider secrets (environment variables only; never commit .env)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Application connections (DATABASE_URL may be any PostgreSQL with pgvector)
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag
VECTOR_DB_URL=

# Optional: protects the internal admin routes (/internal/ingest, /internal/api-keys).
# Leave it unset and those routes are not mounted at all, which is the default.
# ADMIN_API_TOKEN=

# Local docker-compose Postgres
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag

# Optional: database used by the test suite (created and wiped automatically)
# TEST_DATABASE_URL=postgresql://rag:rag@localhost:5432/rag_test

# Optional: override the config file location (default: config.yaml)
# CONFIG_PATH=config.yaml
